# pylint-odoo de los repositorios de módulos Odoo de Eclosion IT (copia idéntica en odoo-addons-template).
# valid-odoo-versions es la serie de la rama: la ajusta scripts/setup-repo.sh de la plantilla y, cuando el
# repositorio no tiene configuración propia, odoo-lint.yml con su input odoo_version.
[MASTER]
load-plugins=pylint_odoo
score=n

[ODOOLINT]
readme-template-url="https://github.com/OCA/maintainer-tools/blob/master/template/module/README.rst"
manifest-required-authors=ECLOSION SAS
manifest-required-keys=license
manifest-deprecated-keys=description,active
license-allowed=OPL-1
valid-odoo-versions=20.0

[MESSAGES CONTROL]
disable=all
enable=anomalous-backslash-in-string,
    attribute-deprecated,
    bad-builtin-groupby,
    context-overridden,
    dangerous-default-value,
    development-status-allowed,
    duplicate-key,
    eval-used,
    external-request-timeout,
    invalid-commit,
    license-allowed,
    manifest-author-string,
    manifest-external-assets,
    manifest-maintainers-list,
    manifest-required-author,
    manifest-required-key,
    manifest-version-format,
    method-inverse,
    method-required-super,
    method-search,
    missing-return,
    no-raise-unlink,
    no-search-all,
    no-write-in-compute,
    odoo-addons-relative-import,
    print-used,
    renamed-field-parameter,
    resource-not-exist,
    sql-injection,
    super-method-mismatch,
    test-folder-imported,
    translation-contains-variable,
    translation-field,
    translation-format-interpolation,
    translation-not-lazy,
    translation-positional-used,
    translation-required,
    unused-variable,
    use-vim-comment,
    website-manifest-key-not-valid-uri
